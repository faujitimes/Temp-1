# Node environment ("production" on Render)
NODE_ENV="production"

# Server port (Render automatically injects PORT at runtime; defaults to 3000 locally)
PORT="3000"

# Public primary URL of your deployed Render service or custom domain (no trailing slash)
APP_URL="https://faujitimes.com"

# Optional comma-separated extra allowed CORS origins (e.g. your temporary *.onrender.com URL)
ALLOWED_ORIGINS="https://faujitimes.onrender.com"

# GEMINI_API_KEY: Optional server-side Gemini AI API key (never expose in frontend VITE_* vars)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
